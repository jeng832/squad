# Squad Environment Variables Example
# Copy this file to .env and fill in the values

# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=squad
MYSQL_USERNAME=squad
MYSQL_PASSWORD=squad

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Secret Encryption Key (must be 32 characters for AES-256)
SECRET_ENCRYPTION_KEY=your-32-character-encryption-key

# LLM API Keys (store in secrets table, not here - this is for reference only)
# CLAUDE_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
